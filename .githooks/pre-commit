#!/usr/bin/env bash
# Pre-commit: format every staged file, as CI's `npm run format:check`
# expects (the owner, 2026-11-02: badly formatted code is simply wrong, so
# fix it rather than refuse it).
#
# What is committed is the staged content, formatted: each staged file's
# staged version is run through `vp fmt` and written back to the index as
# it is, so only the hunks you staged are committed, formatted, even when
# the file holds other changes not staged. The same file in the working
# tree is then formatted too, so it agrees with what was committed; in the
# shared checkout that may reformat another agent's unstaged lines in that
# file, which changes only their layout (the owner accepts this: agents
# broadcast before pushing and can recover).
# Enabled by `git config core.hooksPath .githooks` (`npm install` does it,
# through package.json's `prepare`).
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
vp="node_modules/.bin/vp"
[ -x "$vp" ] || { echo "pre-commit: $vp not found; run npm install" >&2; exit 1; }
changed=()
while IFS= read -r -d '' f; do
  # Files the formatter ignores (vite.config.ts's fmt.ignorePatterns) or
  # cannot parse are left alone: vp names no target for them.
  [ -e "$f" ] || continue
  if "$vp" fmt --check "$f" 2>&1 | grep -q "Expected at least one target"; then
    continue
  fi
  mode=$(git ls-files -s -- "$f" | awk '{print $1; exit}')
  staged=$(git cat-file blob ":$f") || continue
  formatted=$(git cat-file blob ":$f" | "$vp" fmt --stdin-filepath="$f" 2>/dev/null) || {
    echo "pre-commit: could not format $f (a syntax error?)" >&2
    exit 1
  }
  if [ "$staged" != "$formatted" ]; then
    blob=$(printf '%s\n' "$formatted" | git hash-object -w --stdin)
    git update-index --cacheinfo "$mode,$blob,$f"
    "$vp" fmt "$f" >/dev/null 2>&1 || true
    changed+=("$f")
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
if [ ${#changed[@]} -gt 0 ]; then
  echo "pre-commit: formatted ${changed[*]}" >&2
fi
exit 0
